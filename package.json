{
  "name": "stats_app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,worker -c cyan,green,yellow \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:web": "turbo dev",
    "dev:api": "cd apps\\api && .venv\\Scripts\\uvicorn app.main:app --reload --port 8000",
    "dev:worker": "cd apps\\worker && .venv\\Scripts\\python -m app.main",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:api": "cd apps/api && .venv/Scripts/python -m pytest tests -v",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "turbo": "^2.5.6"
  },
  "packageManager": "npm@11.6.0"
}
